{
  "name": "fronybrowser",
  "version": "0.38.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend/core",
    "backend/app",
    "backend/api",
    "backend/cli",
    "frontend"
  ],
  "scripts": {
    "build": "tsc --build && npm run -w frontend build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "vault": "tsx backend/cli/src/index.ts",
    "test:unit": "vitest run --project unit --project frontend",
    "test:integration": "vitest run --project integration",
    "test:live": "cross-env WALLET_LIVE=1 vitest run --project live"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
